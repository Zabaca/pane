---
import Lab from "@/layouts/Lab.astro";
---

<Lab title="Meridian — Editorial">
  <div class="min-h-screen bg-[#faf8f4] font-serif text-stone-900">
    <!-- nav -->
    <header class="mx-auto flex max-w-5xl items-center justify-between px-6 py-8">
      <div class="text-2xl tracking-tight italic">Meridian</div>
      <nav class="hidden gap-8 font-sans text-sm tracking-wide text-stone-500 sm:flex">
        <span>Philosophy</span><span>Membership</span><span>Journal</span>
      </nav>
      <button class="rounded-full border border-stone-900 px-5 py-2 font-sans text-sm font-medium transition hover:bg-stone-900 hover:text-white">
        Apply
      </button>
    </header>

    <div class="mx-auto max-w-5xl px-6">
      <div class="h-px bg-stone-300"></div>
    </div>

    <!-- hero -->
    <section class="mx-auto max-w-5xl px-6 pt-20 pb-24">
      <p class="font-sans text-xs font-semibold tracking-[0.3em] text-stone-400 uppercase">
        A private community for founders
      </p>
      <h1 class="mt-6 max-w-3xl text-6xl leading-[1.05] tracking-tight sm:text-7xl">
        Better questions.<br />
        <em class="text-stone-500">Fewer rooms.</em>
      </h1>
      <div class="mt-12 grid gap-10 sm:grid-cols-[1fr_280px]">
        <p class="max-w-xl text-xl leading-relaxed text-stone-600">
          Meridian is two hundred founders who meet in small, curated circles —
          no pitch decks, no audience, no performance. Just the conversations
          you can't have anywhere else.
        </p>
        <div class="font-sans">
          <button class="w-full rounded-full bg-stone-900 px-6 py-4 text-sm font-semibold text-white transition hover:bg-stone-700">
            Request an invitation
          </button>
          <p class="mt-3 text-center text-xs text-stone-400">
            Spring cohort closes June 30 · 14 seats remain
          </p>
        </div>
      </div>
    </section>

    <!-- big image placeholder -->
    <section class="mx-auto max-w-5xl px-6">
      <div class="flex aspect-[21/9] items-center justify-center rounded-sm bg-stone-200 font-sans text-sm text-stone-400">
        — editorial photograph, members at a table —
      </div>
      <p class="mt-3 font-sans text-xs text-stone-400">Circle № 12, Hudson Valley. Photographed by A. Lindqvist.</p>
    </section>

    <!-- numbered principles -->
    <section class="mx-auto max-w-5xl px-6 py-24">
      <div class="grid gap-12 sm:grid-cols-3">
        {
          [
            ["01", "Curated, not networked", "Eight founders per circle, matched by stage and temperament — never by industry gossip value."],
            ["02", "Chatham House, always", "What's said in circle stays there. Candor is the entire product."],
            ["03", "No content. Presence.", "We don't sell courses. We sell a table, a fire, and people who tell you the truth."],
          ].map(([n, title, desc]) => (
            <div>
              <div class="font-sans text-sm text-stone-400">{n}</div>
              <div class="mt-2 h-px w-12 bg-stone-900"></div>
              <h3 class="mt-4 text-2xl">{title}</h3>
              <p class="mt-3 font-sans text-sm leading-relaxed text-stone-500">{desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- pull quote -->
    <section class="bg-stone-900 px-6 py-24 text-stone-100">
      <blockquote class="mx-auto max-w-3xl text-center">
        <p class="text-3xl leading-snug italic sm:text-4xl">
          "I've raised three rounds and sold two companies. The honest version
          of those stories, I've only ever told at Meridian."
        </p>
        <footer class="mt-8 font-sans text-sm tracking-wide text-stone-400">
          MEMBER, CIRCLE № 7 — NAMES STAY AT THE TABLE
        </footer>
      </blockquote>
    </section>

    <!-- final CTA -->
    <section class="mx-auto max-w-5xl px-6 py-24 pb-36 text-center">
      <h2 class="text-4xl tracking-tight sm:text-5xl">The spring cohort is forming.</h2>
      <p class="mx-auto mt-4 max-w-md font-sans text-sm text-stone-500">
        Applications are read by humans. Expect a reply within a week.
      </p>
      <button class="mt-10 rounded-full bg-stone-900 px-10 py-4 font-sans text-sm font-semibold text-white transition hover:bg-stone-700">
        Request an invitation
      </button>
    </section>
  </div>
</Lab>
