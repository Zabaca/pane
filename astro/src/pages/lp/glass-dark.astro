---
import Lab from "@/layouts/Lab.astro";
---

<Lab title="Nimbus — Glass Dark">
  <div class="relative min-h-screen overflow-hidden bg-[#050507] text-white">
    <!-- aurora -->
    <div class="pointer-events-none absolute -top-32 left-1/4 h-[28rem] w-[44rem] -rotate-12 rounded-full bg-cyan-500/15 blur-[100px]"></div>
    <div class="pointer-events-none absolute top-40 right-0 h-[20rem] w-[30rem] rotate-12 rounded-full bg-emerald-400/10 blur-[100px]"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,0.06),transparent_60%)]"></div>

    <!-- nav -->
    <header class="relative z-10 mx-auto mt-4 flex max-w-5xl items-center justify-between rounded-2xl border border-white/10 bg-white/5 px-5 py-3 backdrop-blur-xl">
      <div class="flex items-center gap-2 font-semibold"><span class="text-cyan-300">◍</span> Nimbus</div>
      <nav class="hidden gap-7 text-sm text-white/50 sm:flex">
        <span>Platform</span><span>Security</span><span>Docs</span><span>Pricing</span>
      </nav>
      <button class="rounded-lg border border-cyan-300/30 bg-cyan-300/10 px-4 py-1.5 text-sm font-semibold text-cyan-200">
        Get access
      </button>
    </header>

    <!-- hero -->
    <section class="relative z-10 mx-auto max-w-3xl px-6 pt-28 pb-16 text-center">
      <span class="rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs text-white/50 backdrop-blur">
        ⌘ Backed by Sequoia · Series A
      </span>
      <h1 class="mt-8 text-5xl leading-tight font-bold tracking-tight sm:text-6xl">
        Your data infra,<br />
        <span class="bg-gradient-to-r from-cyan-300 to-emerald-300 bg-clip-text text-transparent">observed end to end</span>
      </h1>
      <p class="mx-auto mt-6 max-w-lg text-white/50">
        Nimbus traces every byte from ingestion to dashboard. Find broken
        pipelines before your customers find broken numbers.
      </p>

      <!-- glass CTA card -->
      <div class="mx-auto mt-10 max-w-md rounded-2xl border border-white/10 bg-white/5 p-6 shadow-2xl backdrop-blur-xl">
        <div class="flex flex-col gap-2 sm:flex-row">
          <input
            disabled
            placeholder="you@company.com"
            class="flex-1 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm placeholder-white/30 outline-none"
          />
          <button class="rounded-xl bg-gradient-to-r from-cyan-400 to-emerald-400 px-5 py-3 text-sm font-bold text-black">
            Request access
          </button>
        </div>
        <p class="mt-3 text-xs text-white/30">Currently onboarding 10 teams/week. Avg wait: 4 days.</p>
      </div>
    </section>

    <!-- floating glass stats -->
    <section class="relative z-10 mx-auto grid max-w-4xl gap-4 px-6 pb-20 sm:grid-cols-3">
      {
        [
          ["99.99%", "pipeline uptime SLA"],
          ["3 min", "median incident detection"],
          ["40%", "less data downtime, avg"],
        ].map(([n, l]) => (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-6 text-center backdrop-blur-xl">
            <div class="bg-gradient-to-r from-cyan-300 to-emerald-300 bg-clip-text text-3xl font-extrabold text-transparent">{n}</div>
            <div class="mt-1 text-xs text-white/40">{l}</div>
          </div>
        ))
      }
    </section>

    <!-- feature rows -->
    <section class="relative z-10 mx-auto max-w-4xl space-y-4 px-6 pb-32">
      {
        [
          ["🛰", "Lineage you can actually read", "Column-level lineage rendered as a living graph — click any metric and see every upstream hop."],
          ["🚨", "Alerts with context, not noise", "Anomaly detection that ships the affected tables, owners, and likely root cause in one Slack message."],
          ["🔐", "Zero-copy security", "Nimbus reads metadata only. Your data never leaves your warehouse."],
        ].map(([icon, title, desc]) => (
          <div class="flex items-start gap-5 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
            <div class="text-3xl">{icon}</div>
            <div>
              <h3 class="font-bold">{title}</h3>
              <p class="mt-1 text-sm text-white/50">{desc}</p>
            </div>
          </div>
        ))
      }
      <div class="pt-10 text-center">
        <button class="rounded-xl bg-gradient-to-r from-cyan-400 to-emerald-400 px-8 py-3.5 font-bold text-black">
          Request access →
        </button>
      </div>
    </section>
  </div>
</Lab>
